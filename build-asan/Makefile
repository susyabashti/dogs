tests/test_dogs_api.i: tests/test_dogs_api.c.i
.PHONY : tests/test_dogs_api.i

# target to preprocess a source file
tests/test_dogs_api.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/dogs_api_tests.dir/build.make CMakeFiles/dogs_api_tests.dir/tests/test_dogs_api.c.i
.PHONY : tests/test_dogs_api.c.i

tests/test_dogs_api.s: tests/test_dogs_api.c.s
.PHONY : tests/test_dogs_api.s

# target to generate assembly for a file
tests/test_dogs_api.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/dogs_api_tests.dir/build.make CMakeFiles/dogs_api_tests.dir/tests/test_dogs_api.c.s
.PHONY : tests/test_dogs_api.c.s

